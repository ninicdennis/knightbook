{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true, "es2024": true },
  "rules": {
    // The board loads data in effects and sets a loading state first. Reworking
    // that pattern across five components is a separate change, not a lint fix.
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/release/**",
    "**/coverage/**",
    "apps/desktop/resources/**",
    ".projectspace/**"
  ]
}
