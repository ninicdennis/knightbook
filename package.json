{
  "name": "projectspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build:mcp": "pnpm --filter @projectspace/mcp build",
    "pack:dir": "pnpm build:mcp && pnpm --filter @projectspace/desktop pack:dir",
    "preview:board": "pnpm --filter @projectspace/desktop preview:board",
    "experiment:editor": "pnpm --filter @projectspace/experiment-editor-preservation report"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8"
  }
}
