{
  "name": "@knightbook/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview:board": "vite --config vite.preview.config.ts",
    "build": "electron-vite build && node scripts/stage-mcp-runtime.mjs",
    "pack:dir": "node scripts/release-lock-guard.mjs && pnpm build && electron-builder --dir",
    "pack:dir:mac": "node scripts/release-lock-guard.mjs && pnpm build && electron-builder --dir --mac --arm64 --x64",
    "start:packaged": "node scripts/start-packaged.mjs",
    "derive:icon": "electron scripts/derive-icon.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@knightbook/core": "workspace:*",
    "@tabler/icons-react": "^3.47.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.15",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.0",
    "marked": "^18.0.13",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
