---
import DraftNote from './DraftNote.astro'
import type { DraftId } from './drafts'

/**
 * Reserves the space of a product screenshot that does not exist yet, at its
 * intended proportions, with its caption. It draws no imitation of the app:
 * only a marked empty frame, so nothing invented can pass for a real screen.
 */
interface Props {
  draft: DraftId
  caption: string
  /** Width over height of the screenshot that will fill the slot. */
  aspectRatio: string
}

const { draft, caption, aspectRatio } = Astro.props
---

<figure class="slot">
  <div class="frame" style={`aspect-ratio: ${aspectRatio}`}>
    <DraftNote id={draft} />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .slot {
    margin: 0;
    min-width: 0;
  }

  .frame {
    display: grid;
    place-items: center;
    padding: var(--kb-space-5);
    background: var(--kb-surface);
    border: 1px solid var(--kb-border);
    border-radius: var(--kb-radius-lg);
    text-align: center;
  }

  figcaption {
    margin-top: var(--kb-space-3);
    color: var(--kb-muted);
    font-size: 0.9375rem;
  }
</style>
