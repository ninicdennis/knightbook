---
import DraftNote from './DraftNote.astro'
import type { DraftId } from './drafts'

/**
 * The eight questions from the landing-page proposal §4, each answered within
 * its stated boundary. Answers that wait on evidence or a decision say only what
 * is known and carry a draft marker, which a production build refuses.
 * Native <details>, so every answer opens without JavaScript. An answer whose
 * evidence lives in a guide links to it rather than repeating it.
 */
interface Entry {
  question: string
  answer: string
  links?: { href: string; label: string }[]
  draft?: DraftId
}

const entries: Entry[] = [
  {
    question: 'Does Knightbook include an AI assistant?',
    answer:
      'No. Planning and coding happen in the AI tool you already use. Knightbook keeps the project context and work records that tool reads and updates.',
  },
  {
    question: 'Can I use an existing repository?',
    answer:
      "Yes. Choose its local folder. Setting it up adds a .projectspace folder for Knightbook's records; your code and existing Markdown stay where they are, and you choose which documents to include.",
  },
  {
    question: 'Where are my files?',
    answer:
      "In the project folder you choose. Your documents stay where they are, and Knightbook's tickets and records sit beside them in .projectspace. An AI tool you connect, and its provider, handle what they read under their own terms.",
  },
  {
    question: 'Can I edit documents?',
    answer:
      'Read and review them in Knightbook, and edit them in your usual editor; Knightbook shows the changes when you come back to it. Editing formatted documents inside the app is not part of the current release.',
  },
  {
    question: 'Does the app need to stay open?',
    answer:
      "No. Your AI tool starts Knightbook's connection itself, separately from the window, so it can work in the projects you have allowed while Knightbook is closed. When you open the window again, it shows what changed. Checked so far with Claude Code on Linux, not yet on Windows or macOS.",
    links: [
      {
        href: '/docs/connecting-ai/#working-with-the-window-closed',
        label: 'Working with the window closed',
      },
    ],
  },
  {
    question: 'Does it sync across computers?',
    answer:
      'No. Your project is ordinary files in a folder. Move them between computers yourself, for example with Git; Knightbook does not sync them or run Git for you.',
  },
  {
    question: 'Which systems and AI clients work?',
    answer:
      'There are installers for 64-bit Windows 10 and later, macOS 13 and later on Apple silicon and Intel, and 64-bit Debian and Ubuntu Linux. Knightbook connects to AI tools that support MCP, and copies a ready-made configuration for Claude Code, Claude Desktop, Codex and OpenCode. So far it has been tested with Claude Code on Linux; the installers have not yet been tried on a clean computer for each system. If something does not work, report it on GitHub Issues.',
    links: [
      { href: '/docs/connecting-ai/#what-has-been-tested', label: 'What has been tested' },
      { href: '/docs/troubleshooting/#asking-for-help', label: 'Asking for help' },
    ],
  },
  {
    question: 'Is it free, and what is the license?',
    answer:
      'Yes, Knightbook is free. Its source code is public under the Functional Source License (FSL-1.1-ALv2): you can use, change and share it for any purpose except offering it, or something built from it, as a competing commercial product. Two years after each version is released, that version is also available under the Apache License 2.0.',
  },
]
---

<section class="kb-page faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Questions, answered</h2>
  <div class="list">
    {entries.map((entry) => (
      <details>
        <summary>{entry.question}</summary>
        <p>{entry.answer}</p>
        {entry.links && (
          <p class="links">
            {entry.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </p>
        )}
        {entry.draft && <DraftNote id={entry.draft} />}
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding-block: 88px;
  }

  h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.125rem);
    margin-bottom: var(--kb-space-5);
  }

  .list {
    max-width: 72ch;
    border-top: 1px solid var(--kb-border);
  }

  details {
    border-bottom: 1px solid var(--kb-border);
  }

  summary {
    display: list-item;
    min-height: 44px;
    padding-block: var(--kb-space-4);
    cursor: pointer;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  details p {
    margin-bottom: var(--kb-space-3);
    color: var(--kb-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--kb-space-4);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }

  details[open] {
    padding-bottom: var(--kb-space-4);
  }

  @media (max-width: 560px) {
    .faq {
      padding-block: 56px;
    }
  }
</style>
