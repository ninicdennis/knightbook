---
import BaseLayout from '../layout/BaseLayout.astro'
import DownloadAction from '../download/DownloadAction.astro'
import Faq from '../home/Faq.astro'
import FeatureSections from '../home/FeatureSections.astro'
import HomeHero from '../home/HomeHero.astro'
import HowItWorks from '../home/HowItWorks.astro'
import { refuseDraftsInProduction } from '../home/drafts'

/*
 * The homepage, in the order of the design brief: hero, how it works, three
 * explanations, FAQ, closing action. Every draft it shows is listed here, so a
 * production build fails and names them all until each place is real.
 */
refuseDraftsInProduction([])
---

<BaseLayout
  title="Knightbook"
  description="A desktop workspace that keeps project documents, decisions and a work board together, next to the AI tools you already use."
>
  <HomeHero />
  <HowItWorks />
  <FeatureSections />
  <Faq />

  <section class="kb-page closing" aria-labelledby="closing-title">
    <h2 id="closing-title">Keep the next session connected to the project.</h2>
    <DownloadAction />
    <p class="guide">
      <a href="/docs/getting-started/">Read the getting-started guide</a>
    </p>
  </section>
</BaseLayout>

<style>
  .closing {
    padding-block: 88px 0;
  }

  .closing h2 {
    max-width: 24ch;
    margin-bottom: var(--kb-space-5);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.125rem);
  }

  .guide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-3);
    margin: var(--kb-space-4) 0 0;
  }

  .guide a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }
</style>
