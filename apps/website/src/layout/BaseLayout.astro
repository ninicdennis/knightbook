---
import { getImage } from 'astro:assets'
import { isProductionBuild } from '../home/drafts'
import logo from './logo'
import SiteFooter from './SiteFooter.astro'
import SiteHeader from './SiteHeader.astro'
import './tokens.css'
import './base.css'

/**
 * The frame every page shares: head metadata, a skip link as the first focusable
 * element, the header, the page's own content in <main>, and the footer.
 *
 * Any build that is not production is a preview (D-044): every page asks search
 * engines not to index it and says it is a preview, so a preview someone opens
 * from a pull request's artifact is never mistaken for the published site.
 */
interface Props {
  /** The page's own title; " · Knightbook" is added, except on the homepage. */
  title: string
  description: string
}

const { title, description } = Astro.props
const fullTitle = title === 'Knightbook' ? title : `${title} · Knightbook`
const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' })
const preview = !isProductionBuild()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {preview && (
      <p class="preview-banner" role="note">
        Preview build. This is not the published Knightbook website.
      </p>
    )}
    <SiteHeader pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--kb-space-4);
    top: -100px;
    z-index: 10;
    padding: var(--kb-space-2) var(--kb-space-4);
    border-radius: var(--kb-radius);
    background: var(--kb-surface);
    color: var(--kb-text);
    font-weight: 600;
    box-shadow: var(--kb-shadow);
  }

  .skip-link:focus {
    top: var(--kb-space-2);
  }

  .preview-banner {
    margin: 0;
    padding: var(--kb-space-2) var(--kb-space-4);
    background: var(--kb-surface-quiet);
    border-bottom: 2px dashed var(--kb-warning);
    color: var(--kb-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  main:focus {
    outline: none;
  }
</style>
