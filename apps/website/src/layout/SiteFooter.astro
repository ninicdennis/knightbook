---
import { downloadLink, primaryNavigation } from './navigation'

/**
 * The footer on every page. License and support links join `footerLinks` once
 * they are chosen (tickets a677c856 and c125336d); until then nothing stands in
 * for them, so no link points at an undecided page.
 */
const footerLinks = [downloadLink, ...primaryNavigation.filter((link) => !link.href.includes('#'))]
---

<footer class="site-footer">
  <div class="kb-page row">
    <p class="name">Knightbook</p>
    <nav aria-label="Footer">
      <ul>
        {footerLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--kb-space-8);
    background: var(--kb-surface-quiet);
    border-top: 1px solid var(--kb-border);
    color: var(--kb-muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding-block: var(--kb-space-5);
  }

  .name {
    margin: 0;
    font-weight: 600;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--kb-muted);
  }
</style>
