---
import { Image } from 'astro:assets'
import logo from './logo'
import { footerGroups, utilityLinks } from './navigation'

/**
 * The end of every page: the brand with one line on what Knightbook is, then the
 * destinations grouped as Product and Guides, then the utility row: privacy, the
 * license, support and the source code. The row is drawn only when it has
 * destinations, so no link points at an undecided page.
 */
---

<footer class="site-footer">
  <div class="kb-page layout">
    <div class="brand-block">
      <a class="brand" href="/">
        <Image src={logo} alt="" width={28} height={28} densities={[1, 2, 3]} />
        <span>Knightbook</span>
      </a>
      <p class="tagline">Project documents and a work board, together.</p>
    </div>

    <nav class="groups" aria-label="Footer">
      {footerGroups.map((group) => (
        <div class="group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    {utilityLinks.length > 0 && (
      <ul class="utility">
        {utilityLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--kb-space-8);
    background: var(--kb-surface-quiet);
    border-top: 1px solid var(--kb-border);
    color: var(--kb-muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--kb-space-6) var(--kb-space-7);
    padding-block: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--kb-text);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tagline {
    margin: var(--kb-space-3) 0 0;
    font-size: 0.9375rem;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(9rem, auto));
    gap: var(--kb-space-5) var(--kb-space-7);
  }

  h2 {
    margin: 0 0 var(--kb-space-2);
    color: var(--kb-text);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group a,
  .utility a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--kb-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  /* Quiet at rest, like the header's links; the underline appears on hover. */
  .group a:hover,
  .utility a:hover {
    color: var(--kb-text);
    text-decoration: underline;
  }

  .utility {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--kb-space-5);
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-border);
  }

  @media (max-width: 720px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--kb-space-7);
    }

    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--kb-space-5);
    }
  }
</style>
