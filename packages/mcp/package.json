{
  "name": "@knightbook/mcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@knightbook/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
